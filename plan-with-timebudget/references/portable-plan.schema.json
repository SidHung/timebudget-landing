{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeBudget Portable Plan",
  "description": "Normative authoritative and derived fields for TimeBudget portable plan format 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "revision",
    "exported_at",
    "plan",
    "reserves",
    "tasks",
    "snapshot"
  ],
  "properties": {
    "format": { "const": "timebudget-plan" },
    "schema_version": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "exported_at": { "$ref": "#/$defs/auditTimestamp" },
    "plan": { "$ref": "#/$defs/plan" },
    "reserves": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/reserve" }
    },
    "tasks": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/task" }
    },
    "snapshot": { "$ref": "#/$defs/snapshot" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "type": "object",
            "properties": { "lifecycle_status": { "const": "closed" } },
            "required": ["lifecycle_status"]
          }
        },
        "required": ["plan"]
      },
      "then": {
        "properties": {
          "snapshot": {
            "type": "object",
            "properties": { "capacity_status": { "const": "not_evaluated" } },
            "required": ["capacity_status"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "titleText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "minuteTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableMinuteTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/minuteTimestamp" },
        { "type": "null" }
      ]
    },
    "auditTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(?::[0-9]{2}(?:\\.[0-9]+)?)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableAuditTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/auditTimestamp" },
        { "type": "null" }
      ]
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "aggregateDuration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 288000
    },
    "slack": {
      "type": "integer",
      "minimum": -361440,
      "maximum": 1440
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "timezone",
        "start_at",
        "end_at",
        "lifecycle_status",
        "closed_at",
        "close_reason",
        "buffer_original_minutes",
        "buffer_target_minutes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+$"
        },
        "start_at": { "$ref": "#/$defs/minuteTimestamp" },
        "end_at": { "$ref": "#/$defs/minuteTimestamp" },
        "lifecycle_status": {
          "enum": ["draft", "active", "closed"]
        },
        "closed_at": { "$ref": "#/$defs/nullableAuditTimestamp" },
        "close_reason": {
          "oneOf": [
            { "enum": ["all_resolved", "user_ended", "window_ended"] },
            { "type": "null" }
          ]
        },
        "buffer_original_minutes": { "$ref": "#/$defs/duration" },
        "buffer_target_minutes": { "$ref": "#/$defs/duration" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "lifecycle_status": { "const": "closed" } },
            "required": ["lifecycle_status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "closed_at": { "$ref": "#/$defs/auditTimestamp" },
              "close_reason": { "enum": ["all_resolved", "user_ended", "window_ended"] }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "closed_at": { "type": "null" },
              "close_reason": { "type": "null" }
            }
          }
        }
      ]
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "minutes",
        "status",
        "start_at",
        "end_at",
        "remaining_minutes",
        "actual_minutes",
        "consumed_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["meal", "break", "fixed_commitment"] },
        "title": { "$ref": "#/$defs/titleText" },
        "minutes": { "$ref": "#/$defs/duration" },
        "status": { "enum": ["planned", "in_progress", "consumed", "skipped", "cancelled"] },
        "start_at": { "$ref": "#/$defs/nullableMinuteTimestamp" },
        "end_at": { "$ref": "#/$defs/nullableMinuteTimestamp" },
        "remaining_minutes": { "$ref": "#/$defs/duration" },
        "actual_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/duration" },
            { "type": "null" }
          ]
        },
        "consumed_at": { "$ref": "#/$defs/nullableAuditTimestamp" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "start_at": { "$ref": "#/$defs/minuteTimestamp" },
                "end_at": { "$ref": "#/$defs/minuteTimestamp" }
              }
            },
            {
              "type": "object",
              "properties": {
                "start_at": { "type": "null" },
                "end_at": { "type": "null" }
              }
            }
          ]
        },
        {
          "if": {
            "type": "object",
            "properties": { "status": { "const": "consumed" } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "remaining_minutes": { "const": 0 },
              "consumed_at": { "$ref": "#/$defs/auditTimestamp" }
            }
          },
          "else": {
            "type": "object",
            "properties": { "consumed_at": { "type": "null" } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "status": { "enum": ["skipped", "cancelled"] } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": { "remaining_minutes": { "const": 0 } }
          }
        }
      ]
    },
    "estimateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/duration" },
        "max": { "$ref": "#/$defs/duration" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "status",
        "baseline_estimated_minutes",
        "estimate_source",
        "estimate_range_minutes",
        "actual_minutes",
        "actual_source",
        "remaining_estimate_minutes",
        "not_before_at",
        "deadline_at",
        "completed_at",
        "carried_from_plan_id",
        "carried_from_task_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/titleText" },
        "priority": { "enum": ["must", "should", "could"] },
        "status": { "enum": ["planned", "in_progress", "completed", "deferred", "cancelled"] },
        "baseline_estimated_minutes": { "$ref": "#/$defs/duration" },
        "estimate_source": { "enum": ["user", "ai_suggested"] },
        "estimate_range_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/estimateRange" },
            { "type": "null" }
          ]
        },
        "actual_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/duration" },
            { "type": "null" }
          ]
        },
        "actual_source": {
          "oneOf": [
            { "const": "user_reported" },
            { "type": "null" }
          ]
        },
        "remaining_estimate_minutes": { "$ref": "#/$defs/duration" },
        "not_before_at": { "$ref": "#/$defs/nullableMinuteTimestamp" },
        "deadline_at": { "$ref": "#/$defs/nullableMinuteTimestamp" },
        "completed_at": { "$ref": "#/$defs/nullableAuditTimestamp" },
        "carried_from_plan_id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "carried_from_task_id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "remaining_estimate_minutes": { "const": 0 },
              "completed_at": { "$ref": "#/$defs/auditTimestamp" }
            }
          },
          "else": {
            "type": "object",
            "properties": { "completed_at": { "type": "null" } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "status": { "enum": ["deferred", "cancelled"] } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": { "remaining_estimate_minutes": { "const": 0 } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "actual_minutes": { "type": "null" } },
            "required": ["actual_minutes"]
          },
          "then": {
            "type": "object",
            "properties": { "actual_source": { "type": "null" } }
          },
          "else": {
            "type": "object",
            "properties": { "actual_source": { "const": "user_reported" } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "estimate_source": { "const": "user" } },
            "required": ["estimate_source"]
          },
          "then": {
            "type": "object",
            "properties": { "estimate_range_minutes": { "type": "null" } }
          }
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "carried_from_plan_id": { "$ref": "#/$defs/id" },
                "carried_from_task_id": { "$ref": "#/$defs/id" }
              }
            },
            {
              "type": "object",
              "properties": {
                "carried_from_plan_id": { "type": "null" },
                "carried_from_task_id": { "type": "null" }
              }
            }
          ]
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "total_plan_minutes",
        "clock_minutes_remaining",
        "unfinished_estimated_minutes",
        "pending_reserve_minutes",
        "raw_slack_minutes",
        "buffer_target_minutes",
        "safe_slack_minutes",
        "capacity_status"
      ],
      "properties": {
        "as_of": { "$ref": "#/$defs/auditTimestamp" },
        "total_plan_minutes": { "$ref": "#/$defs/duration" },
        "clock_minutes_remaining": {
          "oneOf": [
            { "$ref": "#/$defs/duration" },
            { "type": "null" }
          ]
        },
        "unfinished_estimated_minutes": { "$ref": "#/$defs/aggregateDuration" },
        "pending_reserve_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72000
        },
        "raw_slack_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/slack" },
            { "type": "null" }
          ]
        },
        "buffer_target_minutes": { "$ref": "#/$defs/duration" },
        "safe_slack_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/slack" },
            { "type": "null" }
          ]
        },
        "capacity_status": {
          "enum": ["not_evaluated", "healthy", "at_risk", "replan_required"]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "capacity_status": { "const": "not_evaluated" } },
            "required": ["capacity_status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "clock_minutes_remaining": { "type": "null" },
              "raw_slack_minutes": { "type": "null" },
              "safe_slack_minutes": { "type": "null" }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "clock_minutes_remaining": { "$ref": "#/$defs/duration" },
              "raw_slack_minutes": { "$ref": "#/$defs/slack" },
              "safe_slack_minutes": { "$ref": "#/$defs/slack" }
            }
          }
        }
      ]
    }
  }
}
